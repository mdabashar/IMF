#!/bin/bash -l
#PBS -l select=1:ncpus=1:ngpus=1:mem=30GB:gpu_id=H100
#PBS -l walltime=24:00:00
#PBS -N C1F1.lr34.l1.bf3.r5.F10
cd $PBS_O_WORKDIR
module load GCCcore/13.3.0
module load Python/3.12.3
module load libffi/3.4.5

mkdir venv_basic
cd venv_basic
python -m venv env
cd env
source activate
python -m pip install torchmetrics torch numpy pandas provider --user
cd ../../

python3 main.py --lr=3e-4 --blr=1 --numFirst=1 --numSec=1 --nepoch=30 --length=100 --functionalp=0.3 --ratio=0.5 --bnnp=0.3 --nForwardPasses=10 --earlyStop=30 --scheduler=200
