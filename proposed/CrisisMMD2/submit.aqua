#!/bin/bash -l
#PBS -l select=1:ncpus=1:ngpus=1:mem=10GB:gpu_id=H100
#PBS -l walltime=3:00:00
#PBS -N C2B209538.lr3b4.l1.bf3.r3.s6.F20
cd $PBS_O_WORKDIR
module load GCCcore/13.3.0
module load Python/3.12.3
module load libffi/3.4.5

mkdir venv_basic
cd venv_basic
python -m venv env
cd env
source activate
python -m pip install torchmetrics torch numpy pandas provider --user
cd ../../

python3 main.py --lr=1e-3 --blr=1e-4 --numFirst=1 --numSec=1 --nepoch=50 --length=100 --functionalp=0.3 --ratio=0.3 --bnnp=0.3 --nForwardPasses=20 --earlyStop=300 --scheduler=6
