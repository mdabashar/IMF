#!/bin/bash -l
#PBS -l select=1:ncpus=1:mem=32GB
#PBS -l walltime=24:00:00
#PBS -N r.r3.3b3.l2.FF20.f5b5 
cd $PBS_O_WORKDIR
module load GCCcore/13.3.0
module load Python/3.12.3
module load libffi/3.4.5

mkdir venv_basic
cd venv_basic
python -m venv env
cd env
source activate
python -m pip install datasets evaluate torch numpy pandas provider torchmetrics peft --user
cd ../../

python3 main_meta_new_ms_2bnn.py --lr=1e-3 --blr=1e-3 --numFirst=1 --numSec=1 --nepoch=800 --length=200 --functionalp=0.5 --ratio=0.3 --bnnp=0.5 --nForwardPasses=20
