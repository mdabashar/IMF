#!/bin/bash -l
#PBS -l select=1:ncpus=1:mem=32GB
#PBS -l walltime=10:00:00
#PBS -N M.r3.23.l1.f5.F15
cd $PBS_O_WORKDIR
module load GCCcore/13.3.0
module load Python/3.12.3
module load libffi/3.4.5

mkdir venv_basic
cd venv_basic
python -m venv env
cd env
source activate
python -m pip install datasets evaluate torch numpy pandas provider torchmetrics peft --user
cd ../../

python3 main_meta_new_ms_2bnn.py --fold=1 --lr=2e-3 --nForwardPasses=15 --blr=1 --numf=1 --numsec=1 --nepoch=200 --length=100 --ratio=0.3 --earlyStop=5000 --scheduler=3000
